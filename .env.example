# Public Apps Script web-app URL.
PRODUCT_REQUESTS_API_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Private token from Apps Script Project Settings → Script Properties.
PRODUCT_REQUESTS_API_TOKEN=REPLACE_ME

# Existing EK Affiliaters API token used to generate Flipkart affiliate links.
EKARO_API_TOKEN=REPLACE_ME

# Amazon Creators API (India uses credential version 3.2).
AMAZON_CREATORS_CREDENTIAL_ID=REPLACE_ME
AMAZON_CREATORS_CREDENTIAL_SECRET=REPLACE_ME
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_ASSOCIATE_TAG=bestdaam0a-21
